<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0D0F14" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FACEIT STATS" android:textColor="#FF6A2B" android:textStyle="bold" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Твой CS2 виджет" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Укажи свой FACEIT-ник, SteamID64 и ключ WOK API. Ключ WOK не является ключом FACEIT и не требует регистрации разработчика FACEIT." android:textColor="#A9ADBA" android:textSize="14sp" android:layout_marginTop="8dp" />
    <EditText android:id="@+id/nickname_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="FACEIT nickname" android:text="Elka390" android:textColor="#FFFFFF" android:textColorHint="#777D8B" android:singleLine="true" android:layout_marginTop="24dp" android:padding="14dp" android:backgroundTint="#FF6A2B" />
    <EditText android:id="@+id/steam_id_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="SteamID64" android:inputType="number" android:text="76561199274700343" android:textColor="#FFFFFF" android:textColorHint="#777D8B" android:singleLine="true" android:layout_marginTop="12dp" android:padding="14dp" android:backgroundTint="#FF6A2B" />
    <EditText android:id="@+id/key_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="WOK API key" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#777D8B" android:singleLine="true" android:layout_marginTop="12dp" android:padding="14dp" android:backgroundTint="#FF6A2B" />
    <Button android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить и обновить виджет" android:layout_marginTop="20dp" />
    <TextView android:id="@+id/help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Не отправляй ключ WOK в чат и не публикуй его в GitHub. Он будет сохранён локально в приложении и отправляться сервису WOK для запросов. После сохранения добавь виджет через удержание пустого места на главном экране → Виджеты → FACEIT Stats." android:textColor="#A9ADBA" android:textSize="13sp" android:layout_marginTop="18dp" />
</LinearLayout></ScrollView>