<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="#111318">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FACEIT  /  CS2" android:textColor="#FF6A2B" android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textColor="#FFFFFF" android:textSize="22sp" android:paddingLeft="10dp" android:paddingRight="4dp" android:contentDescription="Refresh" />
    </LinearLayout>
    <TextView android:id="@+id/nickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elka390" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:text="ELO" android:textColor="#969BA8" android:textSize="10sp"/><TextView android:id="@+id/elo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#7CFF9B" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:text="K/D" android:textColor="#969BA8" android:textSize="10sp"/><TextView android:id="@+id/kd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:text="WIN RATE" android:textColor="#969BA8" android:textSize="10sp"/><TextView android:id="@+id/winrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#7CFF9B" android:textSize="20sp" android:textStyle="bold"/></LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Открой приложение и добавь API key" android:textColor="#969BA8" android:textSize="10sp" android:layout_marginTop="3dp" />
</LinearLayout>
